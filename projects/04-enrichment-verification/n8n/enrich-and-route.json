{
  "name": "Enrich and route by action (marketing-automation-lab/04)",
  "nodes": [
    {
      "id": "b4e1c7d2-0004-4a6b-8f10-000000000001",
      "name": "Webhook: candidates + checks in",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "b4e1c7d2-0004-4a6b-8f10-0000000000aa",
      "parameters": {
        "httpMethod": "POST",
        "path": "enrichment/batch",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "b4e1c7d2-0004-4a6b-8f10-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-enrichment-url",
              "name": "enrichment_url",
              "value": "http://enrichment:8004",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "b4e1c7d2-0004-4a6b-8f10-000000000003",
      "name": "Enrich + precheck + verify + dedupe (one pass)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": false,
      "onError": "continueErrorOutput",
      "notes": "No retry: this call can bill paid email finders. A timed-out batch may already be charged; re-post it on purpose, never automatically.",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.enrichment_url }}/v1/enrich/batch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ candidates: $json.body.candidates || [], checks: $json.body.checks || [], now: $json.body.now }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "b4e1c7d2-0004-4a6b-8f10-000000000004",
      "name": "Respond: action summary",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        -200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ candidates_in: $json.candidates_in, people: $json.people, actions: $json.actions, cost: $json.cost }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "b4e1c7d2-0004-4a6b-8f10-000000000005",
      "name": "Respond: enrichment failed (nothing routed)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'enrichment call failed; no person was routed', detail: $json.error }) }}",
        "options": {
          "responseCode": 502
        }
      }
    },
    {
      "id": "b4e1c7d2-0004-4a6b-8f10-000000000006",
      "name": "One item per person",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        700,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "results",
        "include": "noOtherFields",
        "options": {}
