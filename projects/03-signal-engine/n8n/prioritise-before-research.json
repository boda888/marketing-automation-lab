      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-signal-url",
              "name": "signal_engine_url",
              "value": "http://signal-engine:8003",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "a3f5c901-0003-4c1e-9d40-000000000003",
      "name": "Dedupe + tier (signal engine)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.signal_engine_url }}/v1/signals/prioritise",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ events: $json.body.events || [], headcount: $json.body.headcount || [], as_of: $json.body.as_of }) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "a3f5c901-0003-4c1e-9d40-000000000004",
      "name": "Respond: tier summary",
