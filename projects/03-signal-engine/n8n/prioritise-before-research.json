      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ as_of: $json.as_of, tier_counts: $json.tier_counts, dedupe: $json.dedupe }) }}",
        "options": {
          "responseCode": 200
        }
