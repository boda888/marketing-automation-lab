{
  "now": 1800000000,
  "about": "Synthetic leads on .example domains and what a scripted sequencer answers on each attempt. 'status' is an HTTP answer on the success output (Never Error); 'error' is an item on the error output (no HTTP answer). Not recorded from a real vendor.",
  "leads": [
    {
      "lead": {"email": "ana@acme.example", "first_name": "Ana", "company": "Acme"},
      "answers": [{"status": 201}],
      "expect": {"end": "done", "pushes": 1, "waits_s": []}
    },
    {
      "lead": {"email": "ben@birch.example", "first_name": "Ben", "company": "Birch"},
      "answers": [{"status": 429, "headers": {"retry-after": "7"}}, {"status": 201}],
      "expect": {"end": "done", "pushes": 2, "waits_s": [7]}
    },
    {
      "lead": {"email": "cara@cobalt.example", "first_name": "Cara", "company": "Cobalt"},
      "answers": [{"status": 502}],
      "expect": {"end": "dlq", "outcome": "unknown", "pushes": 1, "waits_s": [], "safe_to_resend": false}
    },
    {
      "lead": {"email": "dev@dune.example", "first_name": "Dev", "company": "Dune"},
      "answers": [{"error": {"code": "ECONNREFUSED", "message": "connect ECONNREFUSED"}}, {"status": 200}],
      "expect": {"end": "done", "pushes": 2, "waits_s": [1]}
    },
    {
      "lead": {"email": "eli@elm.example", "first_name": "Eli", "company": "Elm"},
      "answers": [{"error": {"message": "socket hang up"}}],
      "expect": {"end": "dlq", "outcome": "unknown", "pushes": 1, "waits_s": [], "safe_to_resend": false}
    },
    {
      "lead": {"email": "fay@fjord.example", "first_name": "Fay", "company": "Fjord"},
      "answers": [{"status": 429, "headers": {"Retry-After": "900"}}],
      "expect": {"end": "dlq", "outcome": "deferred", "pushes": 1, "waits_s": [], "safe_to_resend": true}
    },
    {
      "lead": {"email": "gus@gale.example", "first_name": "Gus", "company": "Gale"},
      "answers": [{"status": 400}],
      "expect": {"end": "dlq", "outcome": "failed", "pushes": 1, "waits_s": [], "safe_to_resend": false}
    },
    {
      "lead": {"email": "hal@heath.example", "first_name": "Hal", "company": "Heath"},
      "answers": [{"status": 429}, {"status": 429}, {"status": 429}, {"status": 429}],
      "expect": {"end": "dlq", "outcome": "exhausted", "pushes": 4, "waits_s": [1, 2, 4], "safe_to_resend": true}
    }
  ]
}
