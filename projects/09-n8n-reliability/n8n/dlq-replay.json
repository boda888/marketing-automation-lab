{
  "name": "09 · DLQ replay (safe rows only) and open-unsafe alert",
  "nodes": [
    {
      "id": "c4d9e1f0-0009-4b2a-9c20-000000000001",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "notes": "Replays only what the DLQ store says is safe; a missed or doubled run changes nothing because each row is handed out once and every lead is claimed again inside the retry loop.",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "c4d9e1f0-0009-4b2a-9c20-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        200
      ],
      "notes": "scope must equal Config.scope in retry-loop.json: the same vendor:campaign the rows and keys were written under.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "as-reliability_url",
              "name": "reliability_url",
              "value": "http://reliability:8009",
              "type": "string"
            },
            {
              "id": "as-scope",
              "name": "scope",
              "value": "sequencer:campaign-demo",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "c4d9e1f0-0009-4b2a-9c20-000000000003",
      "name": "Replay due rows (POST /v1/dlq/replay)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "retryOnFail": false,
      "notes": "Hands back exhausted rows and deferred rows past retry_at, once each (they move to 'replayed'). unknown / failed rows are refused and stay open for a person. No continue-on-error.",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.reliability_url }}/v1/dlq/replay",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ scope: $json.scope }) }}",
        "options": {
          "timeout": 5000
        }
      }
    },
    {
      "id": "c4d9e1f0-0009-4b2a-9c20-000000000004",
      "name": "One item per replayed row",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        100
      ],
      "notes": "An empty 'replay' list yields no items, so nothing below runs on a quiet tick.",
      "parameters": {
        "fieldToSplitOut": "replay",
        "include": "noOtherFields",
        "options": {}
      }
    },
    {
      "id": "c4d9e1f0-0009-4b2a-9c20-000000000005",
      "name": "Lead from payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        100
      ],
      "notes": "The payload is the lead exactly as retry-loop.json stored it.",
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify($json.payload) }}",
        "options": {}
      }
    },
    {
      "id": "c4d9e1f0-0009-4b2a-9c20-000000000006",
      "name": "Push again (retry-loop)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1100,
        100
      ],
      "notes": "Same loop as the first push: each lead claims its key first, so a lead that landed in a later run since its row was written is skipped as 'committed', and a lead that fails again bumps the same DLQ row.",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_retry_loop_workflow_id"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "c4d9e1f0-0009-4b2a-9c20-000000000007",
      "name": "DLQ summary (GET /v1/dlq/summary)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        320
      ],
      "retryOnFail": false,
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.reliability_url }}/v1/dlq/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "scope",
              "value": "={{ $json.scope }}"
            }
          ]
        },
        "options": {
          "timeout": 5000
        }
      }
    },
    {
      "id": "c4d9e1f0-0009-4b2a-9c20-000000000008",
      "name": "Needs a person?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        320
      ],
      "notes": "open_unsafe = open unknown + failed rows: replay will never touch them. unknown needs a vendor read-back, failed needs the data fixed.",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "open-unsafe-gt-0",
              "leftValue": "={{ $json.open_unsafe }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c4d9e1f0-0009-4b2a-9c20-000000000009",
      "name": "Alert: DLQ needs a read-back",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "https://alerts.ops.example/hooks/n8n",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'dlq: ' + $json.open_unsafe + ' rows need a person (unknown = read back, then POST /v1/dlq/{id}/resolve; failed = fix or discard)', summary: $json }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Replay due rows (POST /v1/dlq/replay)",
            "type": "main",
            "index": 0
          },
          {
            "node": "DLQ summary (GET /v1/dlq/summary)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Replay due rows (POST /v1/dlq/replay)": {
      "main": [
        [
          {
            "node": "One item per replayed row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per replayed row": {
      "main": [
        [
          {
            "node": "Lead from payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lead from payload": {
      "main": [
        [
          {
            "node": "Push again (retry-loop)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DLQ summary (GET /v1/dlq/summary)": {
      "main": [
        [
          {
            "node": "Needs a person?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs a person?": {
      "main": [
        [
          {
            "node": "Alert: DLQ needs a read-back",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "REPLACE_error_alert_workflow_id",
    "saveDataErrorExecution": "all"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
