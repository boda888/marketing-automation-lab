      "typeVersion": 4.2,
      "position": [
        1600,
        300
      ],
      "notes": "Sender alerts (lemlist sendLimitReached, Aimfox account_logged_out), unknown event types, rejected deliveries (token mis-configured) and processing errors. Body text is never in the alert.",
