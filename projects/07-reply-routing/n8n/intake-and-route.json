      "retryOnFail": false,
      "onError": "continueErrorOutput",
      "notes": "Same service URL as Config (this path does not pass through it). Bearer token credential (REPLYROUTING_API_TOKEN). 404 = unknown / already filled / evicted key: alert, do not re-post. 503 = deciding failed and the event was put back: safe to post again.",
      "parameters": {
        "method": "POST",
        "url": "http://reply-routing:8007/v1/replies",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_key: $json.body.event_key, body_text: $json.body.body_text }) }}",
        "options": {
          "timeout": 30000
        }
