{
  "name": "Reply intake -> respond -> route outcome and actions (marketing-automation-lab/07)",
  "nodes": [
    {
      "id": "e7b3d5a2-0007-4f1c-8a30-000000000001",
      "name": "Webhook: email reply in",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "e7b3d5a2-0007-4f1c-8a30-0000000000a1",
      "notes": "Point Smartlead / Instantly / lemlist at <n8n>/webhook/reply-intake/<vendor>/<long random token>. The token is checked by the service (fail closed), not here; lemlist's body secret is checked there too (any token segment works for lemlist).",
      "parameters": {
        "httpMethod": "POST",
        "path": "reply-intake/:vendor/:token",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "e7b3d5a2-0007-4f1c-8a30-000000000002",
      "name": "Webhook: LinkedIn reply in",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "e7b3d5a2-0007-4f1c-8a30-0000000000a2",
      "notes": "HeyReach (one event type per webhook: add ?event_type=MESSAGE_REPLY_RECEIVED etc. to the URL) and Aimfox. Vendor payload fields are not documented in any package read (R5 2026-10-26 / 2026-11-06): check the envelope mapping against one real delivery.",
      "parameters": {
        "httpMethod": "POST",
        "path": "linkedin-intake/:vendor/:token",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "e7b3d5a2-0007-4f1c-8a30-000000000003",
      "name": "Email: pass body through",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "The body is forwarded untouched: event keys and the lemlist secret are read by the service.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "as-route",
              "name": "route",
              "value": "intake",
              "type": "string"
            },
            {
              "id": "as-vendor",
              "name": "vendor",
              "value": "={{ $json.params.vendor }}",
              "type": "string"
            },
            {
              "id": "as-token",
              "name": "token",
              "value": "={{ $json.params.token }}",
              "type": "string"
            },
            {
              "id": "as-payload",
              "name": "payload",
              "value": "={{ $json.body }}",
              "type": "object"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "e7b3d5a2-0007-4f1c-8a30-000000000004",
      "name": "LinkedIn: map envelope",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Candidate field names, unconfirmed: message_at must be the message's time (it is part of the reply key), not the delivery time. A missing profile URL or time comes back as outcome invalid -> review, never a guess.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "as-route",
              "name": "route",
              "value": "linkedin",
              "type": "string"
            },
            {
              "id": "as-vendor",
              "name": "vendor",
              "value": "={{ $json.params.vendor }}",
              "type": "string"
            },
            {
              "id": "as-token",
              "name": "token",
              "value": "={{ $json.params.token }}",
              "type": "string"
            },
            {
              "id": "as-payload",
              "name": "payload",
              "value": "={{ ({ event_type: $json.query.event_type || $json.body.event_type || $json.body.eventType || $json.body.type, profile_url: $json.body.lead?.profile_url || $json.body.lead?.linkedin_url || $json.body.profile_url || $json.body.linkedin_url, message_text: $json.body.message?.text || $json.body.message_text || $json.body.text, message_at: $json.body.message?.created_at || $json.body.message_at || $json.body.timestamp, campaign_id: $json.body.campaign?.id || $json.body.campaign_id, sender_account: $json.body.sender?.id || $json.body.account_id }) }}",
              "type": "object"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "e7b3d5a2-0007-4f1c-8a30-000000000005",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        150
      ],
      "notes": "One service URL. Sub-workflow ids for actions are set on the Execute nodes; the alert URL on the Alert node.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-url",
              "name": "reply_routing_url",
              "value": "http://reply-routing:8007",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "e7b3d5a2-0007-4f1c-8a30-000000000006",
      "name": "Intake (dedupe + classify + route)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        150
      ],
      "retryOnFail": false,
      "onError": "continueErrorOutput",
      "notes": "No n8n retry: the vendor's own retry re-sends, and the service's dedupe store makes that safe. neverError + full response: the service's status code (200 / 401 / 503 / 400 / 404 / 413) is passed back to the vendor unchanged. 10 s timeout stays under the senders' (search summaries).",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.reply_routing_url }}/v1/{{ $json.route }}/{{ encodeURIComponent($json.vendor) }}/{{ encodeURIComponent($json.token) }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "e7b3d5a2-0007-4f1c-8a30-000000000007",
      "name": "Respond to vendor (service status)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        0
      ],
      "notes": "Answer first, act after: 401 lets Smartlead retry after a token fix, 503 makes the vendor resend after a crash (the key was released). Everything decided is 200.",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ outcome: $json.body.outcome, reason: $json.body.reason }) }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      }
    },
    {
      "id": "e7b3d5a2-0007-4f1c-8a30-000000000008",
      "name": "Respond: service unreachable (503)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        400
      ],
      "notes": "Connection refused / timeout: nothing was recorded, so a 503 asks the vendor to resend.",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ outcome: 'error', reason: 'reply routing unreachable' }) }}",
        "options": {
          "responseCode": 503
        }
      }
    },
    {
      "id": "e7b3d5a2-0007-4f1c-8a30-000000000009",
      "name": "Decision",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify(Object.assign({ http_status: $json.statusCode }, $json.body)) }}",
        "includeOtherFields": false,
        "options": {}
      }
    },
