{
  "name": "Capacity before schedule (marketing-automation-lab/02)",
  "nodes": [
    {
      "id": "c2d1e7b3-0003-4b8f-8b20-000000000001",
      "name": "Webhook: campaign leads in",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "c2d1e7b3-0003-4b8f-8b20-0000000000aa",
      "parameters": {
        "httpMethod": "POST",
        "path": "schedule",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "c2d1e7b3-0003-4b8f-8b20-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-preflight-url",
              "name": "preflight_url",
              "value": "http://deliverability-preflight:8002",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "c2d1e7b3-0003-4b8f-8b20-000000000003",
      "name": "Plan today's batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.preflight_url }}/v1/schedule",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mailboxes: $json.body.mailboxes, leads: $json.body.leads, on: $json.body.on }) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "c2d1e7b3-0003-4b8f-8b20-000000000004",
      "name": "Anything to send today?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "has-assignments",
              "leftValue": "={{ $json.assignments.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c2d1e7b3-0003-4b8f-8b20-000000000005",
      "name": "Respond: schedule batch",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ action: \"schedule\", capacity_today: $json.capacity_today, assignments: $json.assignments, deferred: $json.deferred, duplicates: $json.duplicates }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "c2d1e7b3-0003-4b8f-8b20-000000000006",
      "name": "Respond: hold, no capacity",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ action: \"hold\", capacity_today: $json.capacity_today, deferred: $json.deferred, findings: $json.findings.filter(f => f.severity !== \"info\") }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook: campaign leads in": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Plan today's batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Plan today's batch": {
      "main": [
        [
          {
            "node": "Anything to send today?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything to send today?": {
      "main": [
        [
          {
            "node": "Respond: schedule batch",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond: hold, no capacity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
