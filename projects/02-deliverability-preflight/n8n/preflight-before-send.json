{
  "name": "Preflight before send (marketing-automation-lab/02)",
  "nodes": [
    {
      "id": "c2d1e7b3-0002-4b8f-8b20-000000000001",
      "name": "Webhook: campaign in",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "preflight",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "c2d1e7b3-0002-4b8f-8b20-0000000000aa"
    },
    {
      "id": "c2d1e7b3-0002-4b8f-8b20-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-preflight-url",
              "name": "preflight_url",
              "value": "http://deliverability-preflight:8002",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "c2d1e7b3-0002-4b8f-8b20-000000000003",
      "name": "Run preflight",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.preflight_url }}/v1/preflight",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "c2d1e7b3-0002-4b8f-8b20-000000000004",
      "name": "Switch on verdict",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.verdict }}",
                    "rightValue": "pass",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "pass"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.verdict }}",
                    "rightValue": "review",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "review"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.verdict }}",
                    "rightValue": "block",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "block"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c2d1e7b3-0002-4b8f-8b20-000000000005",
      "name": "Respond: send",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        -120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ action: \"send\", verdict: $json.verdict }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "c2d1e7b3-0002-4b8f-8b20-000000000006",
      "name": "Respond: hold for human review",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ action: \"hold_for_review\", verdict: $json.verdict, findings: $json.findings.filter(f => f.severity !== \"info\") }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "c2d1e7b3-0002-4b8f-8b20-000000000007",
      "name": "Respond: block campaign",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ action: \"block\", verdict: $json.verdict, findings: $json.findings.filter(f => f.severity === \"error\") }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
